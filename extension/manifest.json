{
  "manifest_version": 3,
  "name": "Dark Pattern Detector",
  "version": "1.0",
  "description": "Detects deceptive UI using AI",
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:5000/*"], 
  "background": {"service_worker": "background.js"}, 
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}